<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', 'Helvetica', 'Arial', 'sans-serif'],
          },
          colors: {
            apple: {
              bg: '#F5F5F7',
              card: '#FFFFFF',
              blue: '#0071E3',
              blueHover: '#0077ED',
              text: '#1D1D1F',
              subtext: '#86868B',
              border: '#D2D2D7'
            }
          },
          animation: {
            'fade-in-up': 'fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards',
          },
          keyframes: {
            fadeInUp: {
              '0%': { opacity: '0', transform: 'translateY(20px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' },
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    input:focus {
      outline: none;
    }
    .glass-effect {
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: saturate(180%) blur(20px);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
    }
  </style>
</head>
<body class="bg-apple-bg text-apple-text font-sans min-h-screen flex flex-col">

  <%- include('./header'); %>
  <%- include('./error_messages'); %>

  <main class="flex-grow container mx-auto px-4 flex items-center justify-center">
    <div class="animate-fade-in-up w-full max-w-md" style="opacity: 0;">
      <div class="glass-effect rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white p-10">
        
        <div class="text-center mb-8">
            <h1 class="text-3xl font-semibold tracking-tight mb-2">新規登録</h1>
            <p class="text-apple-subtext">新しいアカウントを作成して始めましょう。</p>
        </div>

        <form action="/signup" method="post" class="flex flex-col space-y-5">
          <div>
              <label for="username" class="block text-sm font-medium text-apple-text mb-2 ml-1">ユーザ名</label>
              <input 
                id="username"
                required 
                type="text" 
                name="username" 
                class="w-full px-5 py-4 text-lg bg-gray-50/50 rounded-2xl border border-apple-border/50 focus:border-apple-blue focus:bg-white focus:ring-4 focus:ring-apple-blue/20 transition-all duration-300"
              />
          </div>
          
          <div>
              <label for="password" class="block text-sm font-medium text-apple-text mb-2 ml-1">パスワード</label>
              <input 
                id="password"
                required 
                type="password" 
                name="password" 
                class="w-full px-5 py-4 text-lg bg-gray-50/50 rounded-2xl border border-apple-border/50 focus:border-apple-blue focus:bg-white focus:ring-4 focus:ring-apple-blue/20 transition-all duration-300"
              />
          </div>

          <div>
            <label for="repassword" class="block text-sm font-medium text-apple-text mb-2 ml-1">パスワード（再入力）</label>
            <input 
              id="repassword"
              required 
              type="password" 
              name="repassword" 
              class="w-full px-5 py-4 text-lg bg-gray-50/50 rounded-2xl border border-apple-border/50 focus:border-apple-blue focus:bg-white focus:ring-4 focus:ring-apple-blue/20 transition-all duration-300"
            />
        </div>

          <div class="pt-4">
              <button 
                type="submit" 
                class="w-full bg-apple-blue text-white text-lg font-medium py-4 px-6 rounded-2xl hover:bg-apple-blueHover hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 shadow-sm"
              >
                アカウントを作成
              </button>
          </div>
        </form>
        
        <div class="mt-8 text-center text-sm text-apple-subtext">
            すでにアカウントをお持ちですか？ <a href="/signin" class="text-apple-blue hover:underline">サインイン</a>
        </div>

      </div>
    </div>
  </main>

</body>
</html>