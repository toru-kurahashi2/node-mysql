<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
  <!-- <link rel='stylesheet' href='/stylesheets/style.css'/> -->
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.2.1/css/bootstrap.min.css" integrity="sha384-GJzZqFGwb1QTTN6wy59ffF1BuGJpLSa9DkKMp0DgiMDm4iYMj70gZWKYbI706tWS" crossorigin="anonymous">
</head>
<body>
 <%- include('./hearder.ejs') %>
<style>
    .task-done {
        text-decoration: line-through;
        color: #888;
    }
</style>
<% if(isAuth) { %>
<main class="container py-5">
    <h1>ToDoリスト</h1>
    <%- include('./error_messages.ejs', { errorMessage: errorMessage }) %>
    <form class="my-4" action="/" method="post">
        <div class="form-group">
            <input type="text" class="form-control" name="content" placeholder="新しいタスクを入力してください">
        </div>
        <button type="submit" class="btn btn-primary">タスクを追加</button>
    </form>
    <ul class="list-group">
        <% tasks.forEach(task => { %>
        <li class="list-group-item d-flex align-items-center">
            <form action="/complete" method="post" class="d-inline mr-3">
                <input type="hidden" name="task_id" value="<%= task.id %>">
                <input type="checkbox" onchange="this.form.submit()" <%= task.is_done ? 'checked' : '' %>>
            </form>
            <span class="<%= task.is_done ? 'task-done' : '' %>"><%= task.content %></span>
        </li>
        <% }) %>
    </ul>
</main>
<% } else { %>
  <h1>Welcome to the TodoApp</h1>
  <a class="btn btn-primary" href="/signup" role="button">Sign up now!</a>
  <!-- <a href="/signup">Sign up now!</a> -->
<% } %>
</body>
</html>