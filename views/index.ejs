<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['-apple-system', 'BlinkMacSystemFont', '"Segoe UI"', 'Roboto', 'Helvetica', 'Arial', 'sans-serif'],
          },
          colors: {
            apple: {
              bg: '#F5F5F7',
              card: '#FFFFFF',
              blue: '#0071E3',
              blueHover: '#0077ED',
              text: '#1D1D1F',
              subtext: '#86868B',
              border: '#D2D2D7'
            }
          },
          animation: {
            'fade-in-up': 'fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards',
          },
          keyframes: {
            fadeInUp: {
              '0%': { opacity: '0', transform: 'translateY(20px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' },
            }
          }
        }
      }
    }
  </script>
  <style>
    body {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    input:focus {
      outline: none;
    }
    .glass-effect {
      background: rgba(255, 255, 255, 0.65);
      backdrop-filter: saturate(180%) blur(20px);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
    }
  </style>
</head>
<body class="bg-apple-bg text-apple-text font-sans min-h-screen flex flex-col">

  <%- include('./header'); %>
  <%- include('./error_messages'); %>

  <main class="flex-grow container mx-auto px-4 py-12 max-w-5xl">
    <% if(isAuth) { %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        
        <div class="animate-fade-in-up" style="animation-delay: 0.1s; opacity: 0;">
          <div class="glass-effect rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white p-8">
            <h2 class="text-2xl font-semibold mb-6 tracking-tight">タスクを追加</h2>
            <form action="/" method="post" class="flex flex-col space-y-5">
              <input 
                required 
                type="text" 
                name="add" 
                placeholder="何をする?"
                class="w-full px-5 py-4 text-lg bg-gray-50/50 rounded-2xl border border-apple-border/50 focus:border-apple-blue focus:bg-white focus:ring-4 focus:ring-apple-blue/20 transition-all duration-300"
              />
              <button 
                type="submit" 
                class="w-full bg-apple-blue text-white text-lg font-medium py-4 px-6 rounded-2xl hover:bg-apple-blueHover hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 shadow-sm"
              >
                追加する
              </button>
            </form>
          </div>
        </div>

        <div class="animate-fade-in-up" style="animation-delay: 0.2s; opacity: 0;">
          <div class="glass-effect rounded-3xl shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-white overflow-hidden">
            <h2 class="text-2xl font-semibold p-8 pb-4 tracking-tight">タスク一覧</h2>
            <% if (todos && todos.length > 0) { %>
              <ul class="px-8 pb-6">
                <% for(let todo of todos){ %>
                  <li class="py-4 border-b border-apple-border/30 last:border-0 flex items-center group transition-colors duration-200 hover:bg-black/[0.02] -mx-4 px-4 rounded-xl">
                    <div class="w-6 h-6 rounded-full border-2 border-apple-border group-hover:border-apple-blue/50 mr-4 transition-colors duration-200 flex-shrink-0"></div>
                    <span class="text-xl text-apple-text tracking-tight"><%= todo.title %></span>
                  </li>
                <% } %>
              </ul>
            <% } else { %>
              <div class="p-12 text-apple-subtext text-center text-lg">
                タスクがありません
              </div>
            <% } %>
          </div>
        </div>

      </div>
    <% } else { %>
      <div class="flex flex-col items-center justify-center min-h-[60vh] text-center animate-fade-in-up">
        <h1 class="text-6xl font-bold mb-6 tracking-tight">Todo</h1>
        <p class="text-apple-subtext mb-10 text-2xl">美しく、シンプルなタスク管理。</p>
        <a 
          href="/signup" 
          class="inline-block bg-apple-blue text-white font-medium text-lg py-4 px-10 rounded-full hover:bg-apple-blueHover hover:scale-[1.03] active:scale-[0.97] transition-all duration-300 shadow-md"
        >
          始める
        </a>
      </div>
    <% } %>
  </main>
</body>
</html>